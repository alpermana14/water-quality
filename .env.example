# Copy to .env. Never commit .env.

# synthetic = generated test data, mysql = your readings
DATA_SOURCE=synthetic

# ----- MySQL: use an account with SELECT only -----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Fill these in from scripts/inspect_db.py
DB_TABLE=
DB_TIME_COLUMN=datetime
# wide = one column per sensor; long = one row per reading, with sensor and value columns
DB_FORMAT=wide
DB_SENSOR_COLUMN=sensor
DB_VALUE_COLUMN=value
# Timezone of timestamps stored in MySQL
DB_TIMEZONE=UTC
DISPLAY_TIMEZONE=Asia/Kuala_Lumpur

# key is the column name (wide) or sensor name (long)
# SENSORS=[{"key":"ph","label":"pH","unit":"pH"},{"key":"do_mgl","label":"Dissolved oxygen","unit":"mg/L"}]

# ----- Access -----
# Who can mark episodes reviewed: name1:token1,name2:token2. Empty means nobody can.
APPROVER_TOKENS=
# Frontend address when deployed on its own domain, for example https://water.example.com
CORS_ORIGINS=

# ----- Optional tuning -----
# TRAIN_DAYS=60
# RETRAIN_HOUR=2
# LGB_THREADS=0
